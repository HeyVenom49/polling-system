# Root .env is only for Docker Compose infra (postgres/redis + published ports).
# Backend secrets → apps/backend/.env
# Frontend Vite URLs → apps/frontend/.env (build defaults match .env.example)

POSTGRES_DB=polling_system
POSTGRES_USER=polling
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional published ports
BACKEND_PORT=3000
FRONTEND_PORT=5173
