PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/polling_system
DB_POOL_MAX=12
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONNECTION_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
# Leave COOKIE_DOMAIN unset for Vercel + Render (different sites).
# Only set when API and app share a parent domain (e.g. .ballotly.app).
# COOKIE_DOMAIN=.ballotly.app
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW=15m
# Strict limit for login/register/forgot/verify only (not /refresh)
AUTH_RATE_LIMIT_MAX=20
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_app_password

EMAIL_VERIFY_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
